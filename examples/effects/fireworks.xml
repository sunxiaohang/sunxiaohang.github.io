<scene width="960" height="640" grid="12x8" caption="soft" shadow="false" glow="true" overlap="off" hold=".4" read="2" poster="-1">
  <!-- 跨年烟花：集中展示粒子 + 节奏 + 镜头。
       做法上三件事：
         1) 整个夜空常驻一组 snow 星尘，营造氛围（loop 模式会自动循环）
         2) 倒计时 3-2-1：每一步 pulse 一个爆开的礼花作为"预热"
         3) 零点时刻多轮 burst 接力：burst 的 life 比 step 的 dur 长，粒子会延续到后续 step
         4) 镜头从远到近再拉回全景，字幕叠在仍在飞的粒子上收尾
       关键：burst 是"一次性"模式，step 结束后粒子继续按自己的 life 飞完全程，所以多轮烟花只需在 step 之间逐步追加 emitter 就好。 -->
  <theme accent="#ffd166" accent2="#ff6b9d" c1="#ffd166" c2="#ff6b9d" c3="#7c6cff" c4="#4cc9f0" c5="#36e0c6" text="#f6f1ff" sub="#a7adda" bg="#07071a"/>

  <layer name="sky" z="0"/>
  <layer name="fx" z="5"/>
  <layer name="ui" z="9"/>

  <!-- 常驻星尘：铺满 12c 画面，缓慢飘动。loop 模式粒子生生不息 -->
  <emitter at="6,4" mode="snow" count="80" spread="7c" speed=".4c" life="7" size=".06c" fill="#8a93d8" alpha=".7" layer="sky"/>

  <!-- 远处小烟花：装饰夜空（整场一直存在） -->
  <emitter at="2,2" mode="burst" count="24" spread=".1c" speed="1.2c" life="2.6" gravity="1.1" size=".09c" fill="#4cc9f0" fill2="#7c6cff" blend="screen" alpha=".6" layer="sky"/>
  <emitter at="10,2.3" mode="burst" count="24" spread=".1c" speed="1.2c" life="2.6" gravity="1.1" size=".09c" fill="#ff6b9d" fill2="#ffd166" blend="screen" alpha=".6" layer="sky"/>

  <text id="hint" at="6,.7" size=".3c" fill="sub" text="2025 → 2026" layer="ui" in="fade"/>

  <!-- 倒计时：数字呼吸着从远到近推进，节奏越来越急 -->
  <step say="还有三秒" dur=".3" hold=".9">
    <text id="num" at="6,4.2" size="2.6c" fill="accent" text="3" in="pop"/>
  </step>
  <step say="两秒" dur=".3" hold=".7">
    <num text="2" pulse=".35"/>
    <emitter at="3.5,3" mode="burst" count="60" spread=".15c" speed="2.4c" life="1.8" gravity="2" size=".11c" fill="c3" fill2="c4" blend="screen" layer="fx"/>
  </step>
  <step say="一秒" dur=".3" hold=".5">
    <num text="1" pulse=".35"/>
    <emitter at="8.5,3.2" mode="burst" count="60" spread=".15c" speed="2.4c" life="1.8" gravity="2" size=".11c" fill="c2" fill2="c1" blend="screen" layer="fx"/>
  </step>

  <!-- 零点：集中爆发三发烟花 + 文字切换 -->
  <step say="新年快乐！" dur=".5" mark="跨年" sound="success">
    <num text="新年快乐" size="1.4c" fill="accent2"/>
    <emitter at="2.5,2.6" mode="burst" count="120" spread=".2c" speed="3.4c" life="2.2" gravity="2.4" size=".12c" fill="#ffd166" fill2="#ff6b9d" blend="screen" layer="fx"/>
    <emitter at="6,2" mode="burst" count="140" spread=".2c" speed="3.8c" life="2.4" gravity="2.4" size=".12c" fill="#4cc9f0" fill2="#7c6cff" blend="screen" layer="fx"/>
    <emitter at="9.5,2.6" mode="burst" count="120" spread=".2c" speed="3.4c" life="2.2" gravity="2.4" size=".12c" fill="#36e0c6" fill2="#ffd166" blend="screen" layer="fx"/>
  </step>

  <!-- 第二轮：从底部喷泉 + 两侧补火 -->
  <step say="礼花此起彼伏" dur=".7">
    <num out/>
    <emitter at="6,6.2" mode="fountain" count="90" spread=".1c" speed="3.2c" life="2" gravity="2.6" size=".1c" fill="#ffd166" fill2="#ff6b9d" blend="screen" layer="fx"/>
    <emitter at="4,3" mode="burst" count="80" spread=".15c" speed="2.8c" life="2" gravity="2.2" size=".1c" fill="#ff6b9d" fill2="#7c6cff" blend="screen" layer="fx"/>
    <emitter at="8,3.4" mode="burst" count="80" spread=".15c" speed="2.8c" life="2" gravity="2.2" size=".1c" fill="#4cc9f0" fill2="#36e0c6" blend="screen" layer="fx"/>
  </step>

  <!-- 推近到祝福；此刻前面几波粒子还在天上飞 -->
  <step say="推近一点，把祝福收下" dur="1.3">
    <camera zoom="1.4" at="6,4.3"/>
    <text id="bless" at="6,4.3" size=".46c" fill="accent" text="愿新的一年闪闪发光" in="type" dur=".9" layer="ui"/>
  </step>

  <!-- 拉回全景，再送最后一发 -->
  <step say="开始新的一年" dur="1.2">
    <camera zoom="1" at="6,4"/>
    <bless out/>
    <text id="end" at="6,4.3" size=".44c" fill="sub" text="HAPPY NEW YEAR · 2026" in="type" dur=".9" layer="ui"/>
    <emitter at="6,2.4" mode="burst" count="110" spread=".2c" speed="3.6c" life="2.4" gravity="2.2" size=".11c" fill="#ffd166" fill2="#4cc9f0" blend="screen" layer="fx"/>
  </step>
</scene>
