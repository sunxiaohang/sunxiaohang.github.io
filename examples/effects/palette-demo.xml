<scene width="800" height="600" grid="9x6" pad="0 0 84 0" palette="porcelain" shadow="false" glow="false" overlap="off" hold=".8">
  <!-- 配色模板：scene 上写一行 palette="…"，背景、默认图形色、文字色、线条色、标签对比度全部自动跟随。
       循环里按序号取色用 pal(i)；想引用语义色，直接在 fill / stroke 里写 accent / accent2 / warn / good / bad / text / sub。
       工具栏的“配色…”下拉框可以一键换成别的模板，这个示例不用改任何一行。 -->
  <step say="系列色 c1~c8：循环里写 pal(i)，一批对象自动配成一套" dur=".5" stagger=".07">
    <for var="i" in="0..7">
      <circle id="s{i}" at="{5 + 2.2 * cos(i * PI / 4 - PI / 2)},{3.5 + 2.2 * sin(i * PI / 4 - PI / 2)}" size=".98c" fill="{pal(i)}" label="{i + 1}" flat=""/>
    </for>
  </step>

  <step say="语义色 accent / warn / good / bad：状态一眼分清" dur=".4" stagger=".1">
    <rect id="p0" at="5,2.6" w="2c" h=".5c" radius="30" fill="accent" label="accent" flat=""/>
    <rect id="p1" at="5,3.2" w="2c" h=".5c" radius="30" fill="warn" label="warn" flat=""/>
    <rect id="p2" at="5,3.8" w="2c" h=".5c" radius="30" fill="good" label="good" flat=""/>
    <rect id="p3" at="5,4.4" w="2c" h=".5c" radius="30" fill="bad" label="bad" flat=""/>
  </step>

  <step say="换一行 palette，整场换色。这里把系列色整体错开一位" dur=".5" stagger=".05">
    <for var="i" in="0..7">
      <change id="s{i}" fill="{pal(i + 1)}" pulse=".12"/>
    </for>
  </step>

  <step say="颜色只是数据：圆环转起来，配色照样跟着走" dur="1.8" stagger=".03">
    <for var="i" in="0..7">
      <change id="s{i}" orbit="2.2c" around="5,3.5" turns=".5" ease="soft"/>
    </for>
  </step>
</scene>
