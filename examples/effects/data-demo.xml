<scene width="900" height="600" grid="5x4">
  <data name="rows">水果,数量,颜色
苹果,3,#ff6b6b
香蕉,5,#ffd166
橙子,4,#ff9f43
葡萄,2,#7c6cff
梨,6,#57d9a3</data>

  <for var="i" in="1..{rows.length}">
    <rect id="card{i}" at="{i},1" w=".8c" h=".8c" fill="{rows[i-1].颜色}" flat="" radius="10"/>
    <text id="lbl{i}" at="{i},2" text="{rows[i-1].水果}" size=".3c"/>
    <text id="num{i}" at="{i},3" text="{rows[i-1].数量}" size=".26c" fill="#9aa3c7"/>
  </for>

  <step say="CSV 数据源：每一行数据生成一张卡片">
    <card1 pulse=".1"/>
    <card2 pulse=".1"/>
  </step>
  <step say="卡片的颜色、名称、数量都来自数据列">
    <card3 pulse=".1"/>
    <card4 pulse=".1"/>
  </step>
  <step say="换成别的 CSV 文件，就换成另一组卡片">
    <card5 pulse=".1"/>
  </step>
</scene>
