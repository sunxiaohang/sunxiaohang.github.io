<scene width="800" height="860" grid="10x8" pad="40 40 140 40" palette="graphite" hold="0.9" read="4">
  <!-- 缓动展览：每种缓动一行（共 8 行），每行一颗球，从左端跑到右端，区别只在 ease。
       先让 8 颗球同时出发"赛跑"，一眼看出快慢差异；再逐行框出来，球退回起点后单独重播一遍。
       框 = 当前讲的那一行：左边把行名圈进去，右边留出余量给过冲的缓动（back / spring / elastic），
       静帧里持久可见，比 pulse 一闪而过更有用。 -->
  <let names="{['linear','soft','snap','in','back','spring','bounce','elastic']}"/>
  <let says="{['linear 匀速：球从头到尾速度不变', 'soft 两头慢、中间快：起步和收尾都很柔和', 'snap 起步快、收尾慢：一下弹出去再慢慢停', 'in 起步慢、越走越快：像加速离开', 'back 先向后退一点蓄力，再冲过终点后回来', 'spring 在终点附近来回弹，幅度逐渐减小', 'bounce 像球落地，一次比一次弹得低', 'elastic 像橡皮筋，在终点附近高频抖动']}"/>
  <let x0="2.6"/>
  <let x1="8.3"/>

  <layer name="focus" z="0"/>
  <layer name="rail" z="1"/>
  <layer name="ball" z="3"/>

  <for var="k" index="i" in="{names}">
    <line from="{x0},{i + 1}" to="{x1},{i + 1}" stroke="sub" alpha=".3" width="2" in="none" layer="rail"/>
    <circle id="s{i}" at="{x0},{i + 1}" size=".1c" fill="sub" alpha=".5" in="none" layer="rail"/>
    <circle id="e{i}" at="{x1},{i + 1}" size=".1c" fill="sub" alpha=".5" in="none" layer="rail"/>
    <text id="nm{i}" at="1.35,{i + 1}" text="{k}" size=".22c" fill="sub" layer="rail" in="fade"/>
  </for>

  <step say="缓动 = 速度的变化方式。8 颗球同一起点、同样时长，只有 ease 不同" dur=".4" stagger=".05" hold=".4">
    <for var="k" index="i" in="{names}">
      <circle id="b{i}" at="{x0},{i + 1}" size=".3c" fill="{pal(i)}" layer="ball"/>
    </for>
  </step>

  <step say="同时出发：谁先到、谁冲过头、谁在终点抖，一目了然" dur="2.4" hold="1">
    <for var="k" index="i" in="{names}">
      <change id="b{i}" at="{x1},{i + 1}" ease="{k}" trail="{pal(i)}"/>
    </for>
  </step>

  <!-- 逐行讲解：框住当前这一行，球退回起点后用该缓动重播；上一行的框退场 -->
  <for var="k" index="i" in="{names}">
    <step say="{says[i]}" dur=".4" hold="1">
      <if test="i > 0"><change id="hl{i - 1}" out/></if>
      <rect id="hl{i}" at="5.05,{i + 1}" w="8.9c" h=".8c" fill="text" alpha=".07" stroke="{pal(i)}"
            width="3" radius="18" layer="focus"/>
      <change id="b{i}" at="{x0},{i + 1}" dur=".3" ease="soft"/>
      <change id="b{i}" at="{x1},{i + 1}" delay=".5" dur="1.8" ease="{k}"/>
    </step>
  </for>
</scene>
