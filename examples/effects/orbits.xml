<scene width="800" height="640" grid="9x7" pad="0 0 84 0" palette="graphite" shadow="false" glow="false" overlap="off" hold="0.4" read="4">
  <!-- 轨道：用表达式生成“同心轨道”。每颗行星的圈数、半径、大小都由循环变量决定——改 n 就能改行星数量。
       克制的配色：圆环用次要色，行星用正文色，只有“当前讲到的那一颗”用主色。 -->
  <let n="6"/>
  <let cx="5"/>
  <let cy="3.5"/>

  <layer name="orbit" z="0"/>
  <layer name="planet" z="5"/>

  <ring id="halo2" at="{cx},{cy}" size="1.9c" stroke="accent" width="1.5" alpha=".18" layer="orbit"/>
  <ring id="halo1" at="{cx},{cy}" size="1.5c" stroke="accent" width="1.5" alpha=".32" layer="orbit"/>
  <circle id="sun" at="{cx},{cy}" size="1.1c" fill="accent" flat="" layer="planet"/>

  <step say="一个太阳，加上 {n} 条轨道" dur=".5" stagger=".1">
    <for var="i" in="1..n">
      <ring id="o{i}" at="{cx},{cy}" size="{i * 0.72 + 1.5}c" stroke="sub" width="1.5" alpha=".38" layer="orbit"/>
    </for>
  </step>

  <step say="每条轨道上放一颗行星，越靠外越大一点" dur=".4" stagger=".12">
    <for var="i" in="1..n">
      <circle id="p{i}" at="{cx + (i * 0.36 + 0.75) * cos(i * 1.7)},{cy + (i * 0.36 + 0.75) * sin(i * 1.7)}"
              size="{0.14 + i * 0.03}c" fill="text" flat="" layer="planet"/>
    </for>
  </step>

  <!-- orbit：绕圆心匀速转圈（真正的圆，不走折线逼近）。半径越大转得越慢（外圈 dur 更长） -->
  <step say="行星开始公转：越靠外越慢，拖尾留下走过的弧线" dur="3" stagger=".15">
    <for var="i" in="1..n">
      <change id="p{i}" orbit="{(i * 0.36 + 0.75)}c" around="{cx},{cy}" turns="0.75"
              dur="{2 + i * 0.7}" ease="linear" trail="sub"/>
    </for>
  </step>

  <step say="太阳脉动，第三颗行星换上主色，作为“当前讲到的那一颗”" dur=".8">
    <sun pulse=".16"/>
    <p3 fill="accent" pulse=".6"/>
  </step>
</scene>
