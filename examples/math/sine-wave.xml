<scene width="900" height="560" grid="12x6" pad="0 0 90 0" palette="graphite" shadow="false" glow="false" overlap="off" hold="0.7" read="4">
  <!-- 正弦波：三条波带（每条 44 个点）。每条的基线不同、相位不同，点的大小随波峰变化，形成景深。
       让相位整体前进，波就“流”起来了；再改一个频率，就是另一种波形。每个点的坐标都是表达式，没有一个手写。 -->
  <step say="y = sin(x)：三条波带，每条 44 个点" dur=".4" stagger=".002">
    <for var="j" in="0..2">
      <for var="i" in="0..43">
        <circle id="d{j}_{i}" at="{2.2 + i * 0.2},{1.7 + j * 1.55 + 0.55 * sin(i * 0.36 + j * 1.2)}"
                size="{0.09 + 0.07 * (1 + sin(i * 0.36 + j * 1.2))}c" fill="{pal(j)}" alpha="{0.55 + 0.45 * (1 + sin(i * 0.36 + j * 1.2)) / 2}" flat=""/>
      </for>
    </for>
  </step>

  <step say="把相位向前推一点，每个点沿着新的正弦值上下移动" dur="1.7" stagger=".002">
    <for var="j" in="0..2">
      <for var="i" in="0..43">
        <change id="d{j}_{i}" at="{2.2 + i * 0.2},{1.7 + j * 1.55 + 0.55 * sin(i * 0.36 + j * 1.2 + 2.2)}"
                size="{0.09 + 0.07 * (1 + sin(i * 0.36 + j * 1.2 + 2.2))}c" ease="soft"/>
      </for>
    </for>
  </step>

  <step say="再推一次：波形整体平移，这就是“行波”" dur="1.7" stagger=".002">
    <for var="j" in="0..2">
      <for var="i" in="0..43">
        <change id="d{j}_{i}" at="{2.2 + i * 0.2},{1.7 + j * 1.55 + 0.55 * sin(i * 0.36 + j * 1.2 + 4.4)}"
                size="{0.09 + 0.07 * (1 + sin(i * 0.36 + j * 1.2 + 4.4))}c" ease="soft"/>
      </for>
    </for>
  </step>

  <step say="改一个频率，同样的点就排成了另一种波形" dur="1.9" stagger=".002">
    <for var="j" in="0..2">
      <for var="i" in="0..43">
        <change id="d{j}_{i}" at="{2.2 + i * 0.2},{1.7 + j * 1.55 + 0.5 * sin(i * 0.72 + j * 1.2)}"
                size="{0.09 + 0.07 * (1 + sin(i * 0.72 + j * 1.2))}c" ease="soft"/>
      </for>
    </for>
  </step>
</scene>
