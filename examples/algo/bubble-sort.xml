<scene width="800" height="520" grid="6x4" pad="30 40 96 40" palette="graphite" shadow="false" glow="false" overlap="off" hold="0.6" read="4">
  <!-- 冒泡排序：6 根柱子，每次比较相邻两根，左边更大就交换。
       swaps 的每一项是 [左边的值, 右边的值, 左边所在列]；柱高 = 数值，所有柱子贴着同一条基线，所以交换只需要改 x。
       颜色克制：未参与的柱子是中性灰，正在交换的一对用主色，排好之后统一变成成功色。 -->
  <let order="{[5,3,6,2,4,1]}"/>
  <let swaps="{[[5,3,1],[6,2,3],[6,4,4],[6,1,5],[5,2,2],[5,4,3],[5,1,4],[3,2,1],[4,1,3],[3,1,2],[2,1,1]]}"/>

  <layer name="base" z="0"/>
  <layer name="bars" z="5"/>

  <line from="0.55,4.45" to="6.45,4.45" stroke="sub" width="2" alpha=".4" layer="base" in="none"/>

  <step say="冒泡排序：相邻两个比较，大的往右换" dur=".5" stagger=".08">
    <for var="v" index="i" in="{order}">
      <rect id="v{v}" at="{i + 1},{4.45 - v * 0.26}" w=".7c" h="{v * 0.52}c" radius="14" fill="sub" label="{v}" flat="" layer="bars"/>
    </for>
  </step>

  <for var="s" index="k" in="{swaps}">
    <step say="第 {k + 1} 次交换：{s[0]} 比 {s[1]} 大，互换位置" dur=".6" hold="0.5">
      <if test="k > 0">
        <change id="v*" fill="sub" dur=".2"/>
      </if>
      <change id="v{s[0]}" at="{s[2] + 1},{4.45 - s[0] * 0.26}" ease="soft"/>
      <change id="v{s[1]}" at="{s[2]},{4.45 - s[1] * 0.26}" ease="soft"/>
      <change id="v{s[0]} v{s[1]}" fill="accent" delay=".2" dur=".3"/>
    </step>
  </for>

  <step say="没有需要交换的相邻对了，排序完成：1 2 3 4 5 6" dur=".7" stagger=".07">
    <for var="v" in="1..6">
      <change id="v{v}" fill="good" pulse=".1"/>
    </for>
  </step>
</scene>
