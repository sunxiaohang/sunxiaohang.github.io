<scene width="960" height="640" grid="12x7" pad="0 0 84 0" shadow="false" glow="false" overlap="off" hold="1" read="4">
  <!-- 年度战报：集中展示第一梯队的新能力——
       渐变卡片（fill→fill2）、数字滚动（count+fmt）、打字机标题（in="type"）、
       镜头推近（camera zoom/at）、背景模糊光斑（blur）。驱动全是声明式，数字和镜头都在步骤里补间。 -->
  <theme accent="#7c6cff" accent2="#36e0c6" c1="#7c6cff" c2="#f72585" c3="#ffb703" c4="#4cc9f0" c5="#36e0c6" text="#eef0ff" sub="#9aa0c8" bg="#0e0f1e"/>
  <let labels="{['访问量', '转化率', '营收 / 万元']}"/>

  <layer name="glow" z="0"/>
  <layer name="card" z="1"/>
  <layer name="txt" z="4"/>

  <!-- 背景柔光：两团模糊色斑，营造氛围，不抢主体 -->
  <circle id="halo1" at="3,5.4" size="4c" fill="accent" alpha=".22" blur="40" blend="screen" flat="" layer="glow" in="fade"/>
  <circle id="halo2" at="9.6,2.9" size="3c" fill="c2" alpha=".2" blur="40" blend="screen" flat="" layer="glow" in="fade"/>

  <step say="先打出标题" dur="1">
    <text id="title" at="6.5,1.5" size=".66c" fill="accent" text="2025 年度战报" in="type" dur="1.1"/>
    <text id="sub" at="6.5,2.35" size=".28c" fill="sub" text="三个数字，看完一整年" in="type" dur=".9" delay=".5"/>
  </step>

  <step say="三张卡片落位，数字从 0 开始滚动" dur=".9" stagger=".12">
    <for var="i" in="0..2">
      <rect id="c{i}" at="{2.5 + i * 4},4.2" w="3.4c" h="2.3c" radius="26" fill="{pal(i + 1)}" fill2="{pal(i + 2)}" gradient="linear 135" flat="" layer="card" in="drop"/>
      <text id="cl{i}" at="{2.5 + i * 4},3.5" size=".26c" fill="#0e0f1e" text="{labels[i]}" layer="txt" in="fade" delay=".2"/>
    </for>
    <text id="v0" at="2.5,4.35" size=".84c" fill="#0e0f1e" count="0" fmt="#" layer="txt" in="fade" delay=".2"/>
    <text id="v1" at="6.5,4.35" size=".84c" fill="#0e0f1e" count="0" fmt="#.0%" layer="txt" in="fade" delay=".2"/>
    <text id="v2" at="10.5,4.35" size=".84c" fill="#0e0f1e" count="0" fmt="¥#" layer="txt" in="fade" delay=".2"/>
  </step>

  <step say="数字一齐滚到终值" dur="1.6">
    <v0 count="128460" ease="out"/>
    <v1 count="3.8" ease="out"/>
    <v2 count="2560" ease="out"/>
  </step>

  <step say="推近到最亮眼的一项：访问量翻了一倍" dur="1.3">
    <camera zoom="1.9" at="2.5,4.2"/>
    <c0 pulse=".06"/>
    <v0 pulse=".12"/>
  </step>

  <step say="拉回全景，收官" dur="1.2">
    <camera zoom="1" at="6.5,4"/>
    <text id="foot" at="6.5,6.2" size=".3c" fill="sub" text="数据驱动 · 一镜到底" in="type" dur="1"/>
  </step>
</scene>
