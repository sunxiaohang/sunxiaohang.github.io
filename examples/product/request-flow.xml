<scene width="960" height="520" grid="9x4" pad="0 0 84 0" palette="aurora" shadow="false" glow="false" overlap="off" hold=".8" read="4">
  <!-- 请求流程图：浏览器 → 网关 → 服务 → 数据库。节点是带副标题的卡片，数据包沿同一条水平线走过去，再原路返回；
       每个连接上标着耗时，最后汇总成总耗时。节点、连线、标签都用 for 按序号排开。 -->
  <let nodes="{['浏览器', '网关', '服务', '数据库']}"/>
  <let subs="{['Client', 'Gateway', 'Service', 'Database']}"/>
  <let ms="{['12 ms', '38 ms', '9 ms']}"/>

  <layer name="links" z="1"/>
  <layer name="nodes" z="3"/>
  <layer name="packet" z="9"/>

  <step say="一次请求要穿过四层" dur=".5" stagger=".14">
    <for var="n" index="i" in="{nodes}">
      <rect id="n{i}" at="{i * 2.3 + 1.65},1.55" w="1.6c" h="1.45c" radius="20" fill="bg2" stroke="sub" width="1.5" flat="" layer="nodes"/>
      <text id="nt{i}" at="{i * 2.3 + 1.65},1.38" text="{n}" size=".32c" fill="text" layer="nodes"/>
      <text id="ns{i}" at="{i * 2.3 + 1.65},1.85" text="{subs[i]}" size=".2c" fill="sub" layer="nodes"/>
    </for>
  </step>

  <step say="节点之间用箭头连起来，表示请求的方向" dur=".5" stagger=".15">
    <for var="i" in="0..2">
      <arrow id="a{i}" from="{i * 2.3 + 2.55},1.55" to="{i * 2.3 + 3.75},1.55" stroke="sub" width="2.5" layer="links"/>
    </for>
  </step>

  <step say="发出请求：数据包依次经过网关和服务，到达数据库" dur="2.4">
    <line id="rail" from="1.65,3.0" to="8.55,3.0" stroke="sub" alpha=".3" width="2" layer="links"/>
    <circle id="pkt" at="1.65,3.0" size=".28c" fill="accent" flat="" layer="packet"/>
    <pkt path="1.65,3.0 3.95,3.0 6.25,3.0 8.55,3.0" ease="soft" trail="accent" delay=".1"/>
    <n1 stroke="accent" width="3" delay=".7"/>
    <n2 stroke="accent" width="3" delay="1.4"/>
    <n3 stroke="accent" width="3" delay="2.1"/>
    <for var="i" in="0..2">
      <text id="ms{i}" at="{i * 2.3 + 3.1},3.5" text="{ms[i]}" size=".21c" fill="sub" delay="{0.5 + i * 0.7}"/>
    </for>
  </step>

  <step say="数据库查到结果，数据包原路返回" dur="2.2">
    <pkt path="8.55,3.0 6.25,3.0 3.95,3.0 1.65,3.0" ease="soft" trail="good" fill="good"/>
    <n3 stroke="good" delay=".2"/>
    <n2 stroke="good" delay=".8"/>
    <n1 stroke="good" delay="1.3"/>
    <n0 stroke="good" delay="1.9"/>
  </step>

  <step say="一来一回，总耗时 59 ms，状态 200" dur=".6" stagger=".1">
    <pkt out/>
    <rect id="ok" at="5.1,4.1" w="2.9c" h=".66c" radius="30" fill="good" flat="" layer="nodes"/>
    <text id="okt" at="5.1,4.1" text="200 OK · 59 ms" size=".3c" fill="bg" layer="packet"/>
  </step>
</scene>
