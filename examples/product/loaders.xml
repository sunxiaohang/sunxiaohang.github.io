<scene width="960" height="520" grid="9x4" pad="0 0 84 0" palette="graphite" shadow="false" glow="false" overlap="off" hold=".8" read="3">
  <!-- 加载动效三件套：旋转的圆点环、弹跳的三点、慢慢填满的进度条。
       全是几何图形 + 缓动：pulse 沿着圆环错峰 = 旋转，jump + bounce = 弹跳，宽度补间 = 进度。 -->
  <layer name="card" z="0"/>
  <layer name="fx" z="5"/>

  <step say="三张卡片，三种常见的“正在处理”" dur=".5" stagger=".12">
    <for var="i" in="0..2">
      <rect id="c{i}" at="{i * 3 + 2},2" w="2.6c" h="2.6c" radius="26" fill="bg2" flat="" layer="card"/>
      <text id="t{i}" at="{i * 3 + 2},3.05" text="{['旋转', '弹跳', '进度'][i]}" size=".24c" fill="sub" layer="fx"/>
    </for>
    <for var="k" in="0..7">
      <circle id="r{k}" at="{2 + 0.62 * cos(k * PI / 4 - PI / 2)},{1.8 + 0.62 * sin(k * PI / 4 - PI / 2)}" size=".2c" fill="accent" alpha=".25" flat="" layer="fx"/>
    </for>
    <for var="k" in="0..2">
      <circle id="j{k}" at="{4.55 + k * 0.45},1.9" size=".28c" fill="accent2" flat="" layer="fx"/>
    </for>
    <rect id="bar0" at="8,1.9" w="1.8c" h=".2c" radius="10" fill="text" alpha=".12" flat="" layer="fx"/>
    <rect id="bar" at="7.1,1.9" w=".06c" h=".2c" radius="10" fill="good" flat="" layer="fx"/>
  </step>

  <step say="圆点环：同一个 pulse，按序号错开时间，就成了旋转" dur=".5">
    <for var="lap" in="0..1">
      <for var="k" in="0..7">
        <change id="r{k}" alpha="1" pulse=".5" delay="{lap * 1.6 + k * 0.2}"/>
      </for>
    </for>
  </step>

  <step say="三个点：jump 加 bounce，依次弹起" dur=".7">
    <for var="lap" in="0..2">
      <for var="k" in="0..2">
        <change id="j{k}" jump=".45c" ease="bounce" delay="{lap * 0.8 + k * 0.16}"/>
      </for>
    </for>
  </step>

  <step say="进度条：宽度从零涨到满，起步和收尾都用 soft，不生硬" dur="1.8">
    <bar at="8,1.9" w="1.8c" ease="soft"/>
  </step>

  <step say="三种加载动效，换配色就换了气质" dur=".6">
    <change id="r*" alpha="1"/>
    <change id="j*" fill="good" pulse=".2"/>
  </step>
</scene>
