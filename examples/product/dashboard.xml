<scene width="900" height="600" grid="9x5" pad="30 40 120 40" palette="porcelain" shadow="false" glow="false" hold="0.8" read="4">
  <!-- 数据看板：三张指标卡 + 一张由 CSV 生成的柱状图。数字、柱高、标签全部来自数据，换一份 CSV 就是另一张看板 -->
  <data name="kpi">指标,数值
访问量,12.4k
转化率,3.8%
营收,¥86k</data>
  <data name="rows">周,值
一,3
二,5
三,4
四,7
五,6
六,9</data>

  <layer name="cards" z="1"/>
  <layer name="txt" z="6"/>

  <step say="一张看板，三个核心指标" dur=".5" stagger=".12">
    <for var="i" in="1..3">
      <rect flat="" id="k{i}" at="{i * 2.5 - 0.5},1.1" w="2.2c" h="1.1c" radius="22" fill="bg2" stroke="sub" width="1" alpha="1" layer="cards"/>
      <text id="kn{i}" at="{i * 2.5 - 0.5},1.3" text="{kpi[i - 1].数值}" size=".5c" fill="text" layer="txt"/>
      <text id="kl{i}" at="{i * 2.5 - 0.5},0.9" text="{kpi[i - 1].指标}" size=".24c" fill="sub" layer="txt"/>
    </for>
  </step>

  <step say="下面是近六周的趋势，柱高直接取自 CSV 的「值」列" dur=".5" stagger=".08">
    <for var="i" in="1..{rows.length}">
      <rect flat="" id="b{i}" at="{i + 1.5},{4.4 - rows[i - 1].值 * 0.14}" w=".6c" h="{rows[i - 1].值 * 0.28}c" radius="10" fill="accent" alpha=".4" in="drop" layer="cards"/>
      <text id="bl{i}" at="{i + 1.5},4.72" text="第{rows[i - 1].周}周" size=".22c" fill="sub" layer="txt" in="fade"/>
    </for>
  </step>

  <step say="最后一周最高，用主色强调" dur=".6">
    <b6 alpha="1" pulse=".12"/>
    <kn1 fill="accent" pulse=".2"/>
  </step>
</scene>
