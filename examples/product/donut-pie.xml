<scene width="900" height="580" grid="9x5" pad="40 40 110 40" palette="aurora" shadow="false" glow="false" overlap="off" hold=".9" read="4">
  <!-- 环形饼图：五个品类的占比。关键：ring 的 draw 从 12 点钟顺时针画多少，配 rot 旋转起始位置，
       几段 ring 拼在一起就是环形饼图。换数据就自动重分布。 -->
  <let labels="{['视频','图文','直播','短视频','其他']}"/>
  <let vals="{[32, 24, 18, 14, 12]}"/>
  <let cumul="{[0, 32, 56, 74, 88]}"/>

  <layer name="arcs" z="4"/>
  <layer name="txt" z="8"/>

  <!-- 底环：灰色整圈，先打底 -->
  <step say="每一段弧代表一个品类的占比" dur=".5">
    <ring id="bg" at="3,2.5" size="3.2c" width=".55c" stroke="sub" alpha=".22" layer="arcs" in="draw"/>
  </step>

  <!-- 五段弧：rot 让每段从累计位置开始，draw 控制弧长 = 比例 -->
  <step say="按百分比依次画出五段弧" dur="1.2" stagger=".2">
    <for var="v" index="i" in="{vals}">
      <ring id="a{i}" at="3,2.5" size="3.2c" width=".55c"
            stroke="{pal(i)}" rot="{cumul[i] * 3.6}" draw="{v / 100}"
            layer="arcs" in="draw"/>
    </for>
  </step>

  <!-- 右侧图例：每行一个色点 + 名称 + 百分比 -->
  <step say="图例按降序排列：视频 32% 居首" dur=".4" stagger=".08">
    <for var="l" index="i" in="{labels}">
      <circle at="5.9,{1.3 + i * 0.5}" size=".32c" fill="{pal(i)}" flat="" layer="txt"/>
      <text at="6.2,{1.3 + i * 0.5}" text="{l}" size=".3c" fill="text" layer="txt" off="40,0"/>
      <text at="7.3,{1.3 + i * 0.5}" text="{vals[i]}%" size=".3c" fill="sub" layer="txt" off="40,0"/>
    </for>
  </step>

  <!-- 中心汇总文字 -->
  <step say="视频类合计 56%：半壁江山" dur=".6" stagger=".1">
    <text id="mid1" at="3,2.1" text="视频类" size=".3c" fill="sub" layer="txt" in="fade"/>
    <text id="mid2" at="3,2.75" text="56%" size="1c" fill="accent" layer="txt" in="pop"/>
    <a0 pulse=".06"/>
    <a1 pulse=".06"/>
  </step>
</scene>
