<scene width="720" height="820" grid="15x15" pad="40 30 120 30" palette="graphite" hold="0.8">
  <!-- 五子棋：15x15 交叉点；棋谱用列表驱动，说明文字与手数一一对应 -->
  <def name="黑" is="circle" size=".86c" fill="#17171f" stroke="#4a4a58" width="1.5" layer="stones"/>
  <def name="白" is="circle" size=".86c" fill="#f6f2e8" stroke="#a39e90" width="1.5" layer="stones"/>

  <layer name="board" z="0">
    <grid fill="#D9BC8A" stroke="#86693A" width="1.3" dots="4,4 12,4 8,8 4,12 12,12" color="#7C6A48" labels/>
  </layer>
  <layer name="stones" z="10"/>
  <layer name="marks" z="20"/>

  <let moves="8,8 9,9 9,8 5,5 10,8 7,9 11,8 12,8 7,8"/>
  <let says="{['黑棋先手，落在棋盘正中的「天元」', '白棋接着下，双方轮流落子', '黑棋贴着自己的子向右延伸', '白棋下在远处，没有注意到威胁', '黑棋连成三子，两端都是空的，叫「活三」', '白棋仍然没有防守', '黑棋连成四子，两端都是空的，叫「活四」', '白棋只能堵住一端', '黑棋在另一端落子，横向五连，获胜！']}"/>

  <step say="五子棋：谁先在横、竖、斜任一方向连成五子，谁就赢">
    <note id="tip" at="8,8" text="天元" side="top" layer="marks"/>
  </step>

  <for var="m" index="k" in="{moves}">
    <step say="{says[k]}">
      <if test="k % 2 == 0"><黑 at="{m}"/></if>
      <else><白 at="{m}"/></else>
      <if test="k == 0"><tip out/></if>
      <if test="k == 4">
        <line id="three" from="8,8" to="10,8" stroke="bad" width="5" layer="marks" delay=".3"/>
        <note id="n3" at="9,8" text="活三" side="top" layer="marks" delay=".5"/>
      </if>
      <if test="k == 6">
        <three to="11,8" delay=".2"/>
        <n3 at="9.5,8" text="活四" delay=".2"/>
      </if>
    </step>
  </for>

  <step say="横向五个黑子连成一线，黑棋获胜！" dur=".8" stagger=".12">
    <board alpha=".6"/>
    <n3 out/>
    <three from="7,8" to="11,8" width="8"/>
    <for var="x" in="7..11">
      <ring at="{x},8" size="1.15c" stroke="warn" layer="marks"/>
    </for>
  </step>
</scene>
