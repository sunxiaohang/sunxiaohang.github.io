<scene width="640" height="800" grid="9x10" pad="30 32 130 32" palette="graphite" hold="0.8" read="4">
  <!-- 中国象棋：9x10 个交叉点，格子是正方形（64px）。红黑双方各用一个 group，方便整体强调。
       规范棋盘：
         · 河界在第 5、6 行之间：中间的竖线在河处断开，只有最左最右两条边线贯穿；河道是一条浅色带，里面写“楚河”“汉界”；
         · 最外圈加粗成外框；炮位、兵位四周有小折角（靠边的一侧省略）；两个九宫各有一对斜线。
       行 1 是黑方底线，行 10 是红方底线；红方的兵走到第 5 行及以上就算过河。 -->
  <def name="红" is="circle" size=".9c" fill="#fbeed2" stroke="#B5473B" width="3" color="#B5473B" layer="pieces"/>
  <def name="黑" is="circle" size=".9c" fill="#fbeed2" stroke="#2b2b2b" width="3" color="#222" layer="pieces"/>

  <layer name="board" z="0"/>
  <layer name="band" z="1"/>
  <layer name="words" z="2"/>
  <layer name="pieces" z="10"/>
  <layer name="marks" z="20"/>

  <grid id="木盘" fill="#D4B07E" stroke="#6B4A22" width="2" frame="4" river="5"
        ticks="2,3 8,3 2,8 8,8 1,4 3,4 5,4 7,4 9,4 1,7 3,7 5,7 7,7 9,7" layer="board"/>
  <!-- 九宫斜线 -->
  <line from="4,1" to="6,3" stroke="#6B4A22" width="2" layer="board" in="none"/>
  <line from="6,1" to="4,3" stroke="#6B4A22" width="2" layer="board" in="none"/>
  <line from="4,8" to="6,10" stroke="#6B4A22" width="2" layer="board" in="none"/>
  <line from="6,8" to="4,10" stroke="#6B4A22" width="2" layer="board" in="none"/>
  <!-- 河道：正好是第 5、6 行之间的一格高、从最左线到最右线的 8 格宽 -->
  <rect id="河道" at="5,5.5" w="8c" h="1c" radius="0" fill="#6B4A22" alpha=".1" flat="" layer="band" in="fade"/>
  <text id="楚河" text="楚河" at="2,5.5" size=".46c" fill="#7A5A2E" layer="words" in="fade"/>
  <text id="汉界" text="汉界" at="8,5.5" size=".46c" fill="#7A5A2E" layer="words" in="fade"/>

  <group name="红方">
    <红 id="r帅" at="5,10" label="帅"/>
    <红 id="r车" at="1,10" label="车"/>
    <红 id="r马" at="2,10" label="马"/>
    <红 id="r炮" at="8,8" label="炮"/>
    <红 id="r兵" at="3,7" label="兵"/>
  </group>
  <group name="黑方">
    <黑 id="b将" at="5,1" label="将"/>
    <黑 id="b车" at="1,1" label="车"/>
    <黑 id="b马" at="2,1" label="马"/>
    <黑 id="b炮" at="8,3" label="炮"/>
    <黑 id="b卒" at="3,4" label="卒"/>
  </group>
  <!-- 炮架：炮和被吃的炮中间必须隔着一个棋子（放在第 4 行，不压在河道文字上） -->
  <黑 id="架" at="8,4" label="卒"/>

  <step say="中国象棋：红方在下，黑方在上，中间是「楚河汉界」" dur="1">
    <红方 pulse="0.15"/>
  </step>

  <step say="「帅」和「将」只能在九宫格里走，每次一格，横竖都行">
    <r帅 at="5,9" ease="snap"/>
    <ring id="r1" at="5,9" size="1.2c" stroke="warn" layer="marks"/>
  </step>

  <step say="「车」走直线，不限格数，但不能越过其他棋子">
    <r1 out/>
    <r车 at="1,5" dur="1"/>
    <arrow id="a车" from="1,10" to="1,5" stroke="warn" width="4" layer="marks" dur=".6"/>
  </step>

  <step say="「马」走「日」字：先直走一格，再斜走一格" dur=".9">
    <a车 out/>
    <r马 path="2,9 3,8"/>
    <line id="rm1" from="2,10" to="2,9" stroke="warn" width="4" layer="marks"/>
    <line id="rm2" from="2,9" to="3,8" stroke="warn" width="4" layer="marks" delay=".4"/>
  </step>

  <step say="「炮」平时像车一样走，不吃子的时候不能跳过别的棋子" dur=".9">
    <rm1 out/>
    <rm2 out/>
    <r炮 at="8,7" jump=".25c"/>
    <arrow id="a炮" from="8,8" to="8,7" stroke="warn" width="4" layer="marks"/>
  </step>

  <step say="「炮」吃子必须隔着一个棋子：炮、中间的炮架、对方的炮，三个排成一线" dur=".8">
    <a炮 out/>
    <ring id="架环" at="8,4" size="1.25c" stroke="good" layer="marks"/>
    <note id="架说明" at="8,4" text="炮架" side="left" layer="marks" delay=".3"/>
  </step>

  <step say="红炮跳过炮架，吃掉了黑炮" dur="1">
    <架环 out/>
    <架说明 out/>
    <r炮 at="8,3" ease="snap"/>
    <b炮 out delay=".6"/>
  </step>

  <step say="「兵」没过河时，只能向前走一格" dur=".8">
    <r兵 at="3,6"/>
    <arrow id="a兵1" from="3,7" to="3,6" stroke="warn" width="4" layer="marks"/>
  </step>

  <step say="走过了河（第 5 行），就算「过河兵」" dur=".8">
    <a兵1 out/>
    <r兵 at="3,5" jump=".25c"/>
    <note id="过河" at="3,5" text="过河兵" side="right" layer="marks" delay=".4"/>
  </step>

  <step say="过河的兵，除了向前，还可以向左或向右走一格" dur=".9">
    <过河 out/>
    <r兵 at="4,5"/>
    <arrow id="a兵2" from="3,5" to="4,5" stroke="warn" width="4" layer="marks"/>
  </step>

  <step say="黑方「将」被红炮和红兵夹击，红方获胜！" dur=".8">
    <a兵2 out/>
    <黑方 alpha=".35"/>
    <红方 pulse="0.2"/>
  </step>
</scene>
