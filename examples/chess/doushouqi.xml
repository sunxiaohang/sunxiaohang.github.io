<scene width="630" height="880" grid="7x9" pad="40 35 120 35" palette="graphite" hold="0.8" read="4">
  <!-- 斗兽棋：7 列 × 9 行的方格，格子是正方形（80px），所以 1c 正好是一格，水域、兽穴、陷阱都和格子严丝合缝。
       规范棋盘：
         · 河：左右各一片，各占 2 列 × 3 行（第 2-3 列、第 5-6 列，第 4-6 行），中间第 4 列是陆路；
         · 兽穴在两端正中，用己方颜色描边；陷阱是兽穴上、左、右的三格，颜色略深，标“阱”；
       动物是带字的圆，按大小排序。地形全部 flat（平面）。 -->
  <let animals="{['象','狮','虎','豹','狼','狗','猫','鼠']}"/>

  <def name="兽" is="circle" size=".8c" stroke="#ffffff" width="3" layer="pieces"/>
  <def name="水" is="rect" fill="#3C7BA8" stroke="#7DB4D6" width="2" radius="8" flat="" layer="water"/>
  <!-- 陷阱：比草地略深的一格，不抢棋子 -->
  <def name="阱" cx="1" cy="1">
    <rect id="{id}" at="{cx},{cy}" w=".94c" h=".94c" radius="8" fill="#2F4F3C" alpha=".7" flat="" layer="map" in="fade"/>
    <text id="{id}字" at="{cx},{cy}" text="阱" size=".26c" fill="#8FB59C" layer="marks" in="fade"/>
  </def>
  <!-- 兽穴：深色一格，己方颜色描边，中间写“穴” -->
  <def name="穴" cx="4" cy="1" tint="c1">
    <rect id="{id}" at="{cx},{cy}" w=".94c" h=".94c" radius="10" fill="#14202A" stroke="{tint}" width="3" flat="" layer="map" in="fade"/>
    <text id="{id}字" at="{cx},{cy}" text="穴" size=".34c" fill="{tint}" layer="marks" in="fade"/>
  </def>

  <layer name="map" z="0"/>
  <layer name="water" z="1"/>
  <layer name="marks" z="3"/>
  <layer name="pieces" z="10"/>
  <layer name="panel" z="18"/>
  <layer name="top" z="20"/>

  <grid style="cell" fill="#4F7F63" stroke="#8DB59A" width="1.5" layer="map" radius="14"/>
  <水 id="河左" at="2.5,5" w="2c" h="3c" in="fade"/>
  <水 id="河右" at="5.5,5" w="2c" h="3c" in="fade"/>
  <穴 id="蓝穴" cx="4" cy="1" tint="c1"/>
  <穴 id="红穴" cx="4" cy="9" tint="c5"/>
  <for var="t" index="k" in="{[[3,1],[5,1],[4,2],[3,9],[5,9],[4,8]]}">
    <阱 id="阱{k}" cx="{t[0]}" cy="{t[1]}"/>
  </for>

  <group name="蓝方">
    <兽 id="b象" at="1,1" label="象" fill="c1"/>
    <兽 id="b鼠" at="7,1" label="鼠" fill="c1"/>
    <兽 id="b猫" at="2,2" label="猫" fill="c1"/>
  </group>
  <group name="红方">
    <兽 id="r象" at="7,9" label="象" fill="c5"/>
    <兽 id="r鼠" at="1,9" label="鼠" fill="c5"/>
    <兽 id="r猫" at="6,8" label="猫" fill="c5"/>
  </group>

  <step say="斗兽棋：中间有两条河，两端各有一个兽穴，谁先走进对方的兽穴谁就赢">
    <蓝方 pulse=".15"/>
    <红方 pulse=".15" delay=".2"/>
  </step>

  <step say="每个动物都有大小，大的能吃小的。我们按顺序排出来" stagger=".12" dur=".5">
    <蓝方 alpha=".25"/>
    <红方 alpha=".25"/>
    <rect id="榜底" at="4,5" w="7c" h="1.7c" radius="22" fill="bg2" stroke="sub" width="1.5" alpha=".96" flat="" layer="panel"/>
    <for var="a" index="i" in="{animals}">
      <circle id="rank{i}" at="{1.14 + i * 0.82},4.8" size=".62c" fill="{hsl(214, 58, 78 - i*7)}" label="{a}" layer="top"/>
    </for>
  </step>

  <step say="大小顺序：象 > 狮 > 虎 > 豹 > 狼 > 狗 > 猫 > 鼠" dur=".6" stagger=".08">
    <for var="i" in="0..6">
      <arrow id="ar{i}" from="rank{i}" to="rank{i + 1}" stroke="warn" width="3" head="12" gap="2" layer="top"/>
    </for>
  </step>

  <step say="但有一个例外：最小的「鼠」可以吃最大的「象」！" dur=".6">
    <change id="rank*" out/>
    <change id="ar*" out/>
    <榜底 out/>
    <蓝方 alpha="1"/>
    <红方 alpha="1"/>
  </step>

  <step say="只有鼠才能下水：红鼠从河里游过去，绕开岸上的猫（黄线是它走过的路）" dur="1.8">
    <r鼠 path="1,7 2.5,5 4,3.2 2,1" smooth trail="warn" ease="soft"/>
  </step>

  <step say="红鼠扑向蓝象，把它吃掉了" dur=".8">
    <r鼠 at="1,1" jump=".5c"/>
    <b象 out delay=".4"/>
    <ring at="1,1" size="1.2c" stroke="warn" layer="top"/>
  </step>

  <step say="记住：这条规则叫「鼠克象」。反过来，象不能吃鼠" dur=".7">
    <note id="rule" at="1,1" text="鼠克象" side="right" layer="top"/>
  </step>
</scene>
