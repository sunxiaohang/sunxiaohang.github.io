<scene width="800" height="640" grid="8x4" pad="90 20 130 20" bg="#f3e5f5" bg2="#e1bee7" hold="0.6" read="3" shadow="false" glow="false">
  <!-- 乘法：3 × 4 = 12。把 4 个一排的点摆 3 排，让孩子看到"几个几"。
       rows、cols 是变量；排与排之间用不同颜色，最后一次性数出总数 -->
  <let rows="3"/>
  <let cols="4"/>

  <layer name="dots" z="5"/>
  <layer name="txt" z="10"/>

  <text id="算式" px="400,50" size=".7c" fill="#7b1fa2" text="" layer="txt"/>

  <step say="乘法就是「几个几」：先看一排，有 {cols} 个" dur=".4" stagger=".1">
    <for var="c" in="1..cols">
      <circle id="d1_{c}" at="{c + 2},1.2" size=".6c" fill="{hsl(280, 70, 62)}" layer="dots"/>
    </for>
    <算式 text="{cols}"/>
  </step>

  <step say="再摆一排，又是 {cols} 个" dur=".4" stagger=".1">
    <for var="c" in="1..cols">
      <circle id="d2_{c}" at="{c + 2},2.2" size=".6c" fill="{hsl(320, 70, 62)}" layer="dots"/>
    </for>
    <算式 text="{cols} + {cols}"/>
  </step>

  <step say="再摆一排，一共 {rows} 排，每排 {cols} 个" dur=".4" stagger=".1">
    <for var="c" in="1..cols">
      <circle id="d3_{c}" at="{c + 2},3.2" size=".6c" fill="{hsl(20, 80, 62)}" layer="dots"/>
    </for>
    <算式 text="{cols} + {cols} + {cols}"/>
  </step>

  <step say="{rows} 个 {cols}，就是 {rows} × {cols}" dur=".7">
    <算式 text="{rows} × {cols}" pulse=".3"/>
  </step>

  <step say="一共有几个点？一排一排地数" dur=".35" stagger=".5" hold="0.4">
    <for var="r" in="1..rows">
      <ring id="rr{r}" at="{(cols + 1) / 2 + 2},{r + 0.2}" size="{cols * 0.62}c" stroke="#ffd54f" layer="txt" width="5"/>
    </for>
  </step>

  <step say="{rows} × {cols} = {rows * cols}" dur=".8">
    <算式 text="{rows} × {cols} = {rows * cols}" pulse=".35"/>
    <change id="rr*" out/>
  </step>
</scene>
