<scene width="800" height="700" grid="3x2" pad="40 20 150 20" bg="#e8f7ff" bg2="#cdeeff" hold="0.8" read="3" shadow="false" glow="false">
  <!-- 幼儿识图：用几何图形拼出 6 样东西，每样一个 def 模板，逐个登场并读出名字。
       模板参数 cx/cy 是格子坐标，模板内部的偏移都以 c(格子)为单位，所以改画布大小也不会走样 -->
  <layer name="art" z="5"/>

  <def name="太阳" cx="1" cy="1">
    <circle id="{id}_a" at="{cx},{cy}" size=".62c" fill="#ffc83d" layer="art" group="{id}"/>
    <for var="k" in="0..7">
      <triangle id="{id}_r{k}" at="{cx + 0.5*cos(k*PI/4)},{cy + 0.5*sin(k*PI/4)}" size=".18c" fill="#ffa41f"
                rot="{k*45 + 90}" layer="art" group="{id}"/>
    </for>
  </def>

  <def name="房子" cx="2" cy="1">
    <rect id="{id}_w" at="{cx},{cy + 0.12}" w=".64c" h=".5c" fill="#ff8a65" radius="6" layer="art" group="{id}"/>
    <triangle id="{id}_r" at="{cx},{cy - 0.26}" size=".78c" fill="#d84343" layer="art" group="{id}"/>
    <rect id="{id}_d" at="{cx},{cy + 0.22}" w=".16c" h=".28c" fill="#8d6e63" radius="4" layer="art" group="{id}"/>
  </def>

  <def name="树" cx="3" cy="1">
    <rect id="{id}_t" at="{cx},{cy + 0.24}" w=".14c" h=".42c" fill="#8d6e63" radius="4" layer="art" group="{id}"/>
    <circle id="{id}_c1" at="{cx},{cy - 0.14}" size=".56c" fill="#3fbf6a" layer="art" group="{id}"/>
    <circle id="{id}_c2" at="{cx - 0.2},{cy + 0.04}" size=".4c" fill="#35a85d" layer="art" group="{id}"/>
    <circle id="{id}_c3" at="{cx + 0.2},{cy + 0.04}" size=".4c" fill="#35a85d" layer="art" group="{id}"/>
  </def>

  <def name="小鱼" cx="1" cy="2">
    <ellipse id="{id}_b" at="{cx},{cy}" w=".62c" h=".38c" fill="#4dabf7" layer="art" group="{id}"/>
    <triangle id="{id}_f" at="{cx + 0.38},{cy}" size=".3c" fill="#339af0" rot="90" layer="art" group="{id}"/>
    <circle id="{id}_e" at="{cx - 0.16},{cy - 0.04}" size=".07c" fill="#ffffff" stroke="#1c3d5a" width="3" layer="art" group="{id}"/>
  </def>

  <def name="小花" cx="2" cy="2">
    <for var="k" in="0..5">
      <circle id="{id}_p{k}" at="{cx + 0.24*cos(k*PI/3)},{cy - 0.1 + 0.24*sin(k*PI/3)}" size=".26c"
              fill="#ff8fb3" layer="art" group="{id}"/>
    </for>
    <circle id="{id}_m" at="{cx},{cy - 0.1}" size=".22c" fill="#ffd54f" layer="art" group="{id}"/>
    <rect id="{id}_s" at="{cx},{cy + 0.32}" w=".06c" h=".34c" fill="#4caf50" radius="3" layer="art" group="{id}"/>
  </def>

  <def name="星星" cx="3" cy="2">
    <star id="{id}_a" at="{cx},{cy}" size=".7c" fill="#ffd43b" layer="art" group="{id}"/>
  </def>

  <step say="我们来认识六样东西，用图形拼成的哦" hold="1"/>

  <step say="这是太阳，圆圆的，有很多光芒">
    <太阳 id="sun" cx="1" cy="1"/>
  </step>
  <step say="太阳出来了，跳一跳">
    <sun jump=".2c" pulse=".1"/>
  </step>
  <step say="这是房子，有红红的三角屋顶">
    <房子 id="house" cx="2" cy="1"/>
  </step>
  <step say="这是大树，绿绿的树叶">
    <树 id="tree" cx="3" cy="1"/>
  </step>
  <step say="这是小鱼，它会游泳">
    <小鱼 id="fish" cx="1" cy="2"/>
  </step>
  <step say="小鱼游一游">
    <fish by="0.16,0" dur=".6" ease="soft"/>
  </step>
  <step say="这是小花，粉红的花瓣">
    <小花 id="flower" cx="2" cy="2"/>
  </step>
  <step say="这是星星，闪闪发光">
    <星星 id="star" cx="3" cy="2"/>
  </step>
  <step say="太阳、房子、大树、小鱼、小花、星星，你都认识了吗？" dur=".8" stagger=".1">
    <sun pulse=".2"/>
    <house pulse=".2"/>
    <tree pulse=".2"/>
    <fish pulse=".2"/>
    <flower pulse=".2"/>
    <star pulse=".25" spin=".1"/>
  </step>
</scene>
