<scene width="800" height="520" grid="8x3" pad="100 20 90 20" palette="porcelain" hold="0.6" read="3" shadow="false" glow="false" overlap="off">
  <!-- 减法：7 - 3 = 4。七个圆点站成一排，最右边的 3 个滑走，剩下的就是答案 -->
  <let total="7"/>
  <let gone="3"/>
  <let o="{(8 - total) / 2}"/>

  <layer name="track" z="0"/>
  <layer name="dots" z="5"/>
  <layer name="txt" z="10"/>

  <def name="圆点" cx="1" cy="2">
    <circle id="{id}_b" at="{cx},{cy}" size=".84c" fill="accent" flat="" layer="dots" group="{id}"/>
  </def>

  <rect id="轨道" at="4.5,2" w="7.6c" h="1.2c" radius="40" fill="text" alpha=".06" flat="" layer="track" in="fade"/>
  <text id="算式" px="400,70" size=".95c" fill="text" text="" layer="txt"/>

  <step say="一共有 {total} 个" dur=".4" stagger=".1">
    <for var="i" in="1..total">
      <圆点 id="n{i}" cx="{o + i}" cy="2"/>
    </for>
    <算式 text="{total}"/>
  </step>

  <step say="拿走 {gone} 个" dur=".8" stagger=".12" hold="0.8">
    <for var="i" in="{total - gone + 1}..{total}">
      <change id="n{i}_b" by="0,1.1" alpha="0" fill="bad" ease="in"/>
    </for>
    <算式 text="{total} - {gone}"/>
  </step>

  <step say="还剩几个？我们数一数" dur=".3" stagger=".25" hold="0.4">
    <for var="i" in="1..(total - gone)">
      <ring id="c{i}" at="{o + i},2" size=".98c" stroke="warn" width="3" layer="txt"/>
    </for>
  </step>

  <step say="{total} 减 {gone} 等于 {total - gone}" dur=".7">
    <算式 text="{total} - {gone} = {total - gone}" pulse=".3"/>
    <for var="i" in="1..(total - gone)">
      <change id="n{i}_b" fill="good"/>
    </for>
  </step>
</scene>
