<scene width="800" height="500" grid="9x6" pad="20 30 70 30" palette="porcelain" shadow="false" glow="false" overlap="off" hold="1">
  <data name="rows">月份,销量
1月,32
2月,48
3月,41
4月,63
5月,57
6月,82
7月,74</data>

  <for var="k" in="1..4">
    <line from="1.2,{5.4 - k * 0.95}" to="8.8,{5.4 - k * 0.95}" stroke="sub" alpha=".22" width="1.5" in="none"/>
  </for>
  <for var="i" in="1..{rows.length}">
    <text id="m{i}" at="{i + 0.9},5.75" text="{rows[i - 1].月份}" size=".26c" fill="sub" in="fade"/>
  </for>

  <step say="CSV 里每一行，对应一根柱子" dur=".6" stagger=".08">
    <for var="i" in="1..{rows.length}">
      <rect id="b{i}" at="{i + 0.9},{5.4 - rows[i - 1].销量 * 0.0225}" w=".62c" h="{rows[i - 1].销量 * 0.045}c" radius="12" fill="accent" alpha=".3" flat="" in="drop"/>
    </for>
  </step>

  <step say="高度来自「销量」这一列，数值写在柱顶" dur=".4" stagger=".06">
    <for var="i" in="1..{rows.length}">
      <text id="v{i}" at="{i + 0.9},{5.4 - rows[i - 1].销量 * 0.045 - 0.3}" text="{rows[i - 1].销量}" size=".28c" fill="text"/>
    </for>
  </step>

  <step say="6 月最高，用主色强调" dur=".6">
    <b6 alpha="1" pulse=".08"/>
    <v6 fill="accent" pulse=".25"/>
  </step>
</scene>
