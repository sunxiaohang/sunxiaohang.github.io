<scene width="960" height="600" grid="17x9" pad="0 0 84 0" palette="graphite" shadow="false" glow="false" overlap="off" hold=".5" seed="3">
  <!-- 首页主视觉：120 个点，同一份脚本里只换“目标位置”，整片点阵就重新排成另一种图案。
       没有一行是在写“怎么移动”——补间、错峰、缓动都是引擎算的。颜色全部取自当前配色。 -->
  <let n="120"/>

  <step say="120 个点，排成整齐的点阵" dur=".5" stagger=".006">
    <for var="i" in="0..119">
      <circle id="d{i}" at="{9 + (i % 15 - 7) * 1.0},{5 + (floor(i / 15) - 3.5) * 0.95}" size=".26c" fill="{pal(i % 3)}" flat=""/>
    </for>
  </step>

  <step say="只写目标位置：向日葵螺旋" dur="1.3" stagger=".008" hold=".9">
    <for var="i" in="0..119">
      <change id="d{i}" at="{9 + 0.385 * sqrt(i + 1) * cos(i * 2.39996)},{5 + 0.385 * sqrt(i + 1) * sin(i * 2.39996)}"
              size="{0.14 + i * 0.0026}c" fill="{pal(floor(i / 40))}" ease="soft"/>
    </for>
  </step>

  <step say="换一组坐标：同心圆环" dur="1.3" stagger=".008" hold=".9">
    <for var="i" in="0..119">
      <change id="d{i}" at="{9 + (i < 24 ? 1.5 : (i < 64 ? 2.8 : 4.1)) * cos((i < 24 ? i / 24 : (i < 64 ? (i - 24) / 40 : (i - 64) / 56)) * 2 * PI + (i < 24 ? 0 : (i < 64 ? 0.4 : 0.8)))},{5 + (i < 24 ? 1.5 : (i < 64 ? 2.8 : 4.1)) * sin((i < 24 ? i / 24 : (i < 64 ? (i - 24) / 40 : (i - 64) / 56)) * 2 * PI + (i < 24 ? 0 : (i < 64 ? 0.4 : 0.8)))}"
              size=".22c" fill="{pal(i < 24 ? 0 : (i < 64 ? 1 : 2))}" ease="soft"/>
    </for>
  </step>

  <step say="再来一组：双螺旋" dur="1.3" stagger=".008" hold=".9">
    <for var="i" in="0..119">
      <change id="d{i}" at="{1.6 + (i % 60) * 0.2475},{5 + 2.3 * sin((i % 60) * 0.3 + (i < 60 ? 0 : PI))}"
              size="{0.14 + 0.13 * (1 + cos((i % 60) * 0.3 + (i < 60 ? 0 : PI)))}c" fill="{pal(i < 60 ? 0 : 2)}" ease="soft"/>
    </for>
  </step>

  <step say="回到点阵。从头到尾，没写过一行“怎么动”" dur="1.3" stagger=".008" hold="1">
    <for var="i" in="0..119">
      <change id="d{i}" at="{9 + (i % 15 - 7) * 1.0},{5 + (floor(i / 15) - 3.5) * 0.95}" size=".26c" fill="{pal(i % 3)}" ease="soft"/>
    </for>
  </step>
</scene>
