<scene width="800" height="500" grid="12x6" pad="10 10 80 10" palette="porcelain" hold="1" overlap="off">
  <for var="p" index="i" in="{['1.5,5', '4,1.8', '6.5,5', '9,1.8', '11.5,4.6']}">
    <ring id="w{i}" at="{p}" size=".5c" stroke="sub" width="2" alpha=".5"/>
  </for>
  <circle id="a" at="1.5,5" size=".34c" fill="accent" flat=""/>

  <step say="沿着五个路标走，只写路径" dur="2.4">
    <a path="1.5,5 4,1.8 6.5,5 9,1.8 11.5,4.6" smooth trail="accent" ease="soft"/>
  </step>

  <step say="到站：每个路标依次亮起" dur=".5" stagger=".18">
    <for var="i" in="0..4">
      <change id="w{i}" stroke="accent" alpha="1" width="4" pulse=".25"/>
    </for>
  </step>

  <step say="走过的路自动留下轨迹，改一个坐标，整条曲线跟着变" dur=".6">
    <a fill="good" pulse=".4"/>
  </step>
</scene>
